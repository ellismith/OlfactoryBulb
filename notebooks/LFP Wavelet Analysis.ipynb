   ],
   "source": [
    "events, vs, t_lfp, lfp, lfp_bp, lfp_bp_hfo, lfp_wavelet_power, scales, wavelet, dt,\\\n",
    "        frequencies, t_average, lfp_wavelet_power_average, params_dict = load_result(paramset='GammaSignature', sniff_count=8)    \n",
    "\n",
    "# Plot scalogram \n",
    "cfs, frequencies = pywt.cwt(lfp_bp, scales, wavelet, dt / 1000.0)\n",
    "lfp_wavelet_power = np.log(1+abs(cfs))\n",
    "def plot_scalogram(times, frequencies, power):\n",
    "    plt.figure(figsize=(12,4))\n",
    "    plt.pcolormesh(t_lfp,frequencies,lfp_wavelet_power,cmap='Blues')\n",
    "    plt.xlabel('Time ($s$)')\n",
    "    plt.ylabel('\"Frequency\" ($Hz$)')\n",
    "    #plt.yscale('log')\n",
    "    plt.colorbar().set_label('LFP Wavelet Power ($V^2/Hz$)')\n",
    "plot_scalogram(t_lfp,frequencies,lfp_wavelet_power)"
   ]
  }
